# CampusWay CLI 配置文件示例
# 项目主页: https://github.com/Simple53/CampusWay

protocol = "easyconnect"             # 协议类型: "easyconnect" 或 "atrust"
server_address = "vpn.example.edu.cn" # 校园网 VPN 网关地址
server_port = 443                    # 网关端口 (通常为 443)
username = ""                        # 统一身份认证学工号
# 建议留空并通过运行时交互或环境变量传入密码，避免在配置文件中保存明文密码
password = ""

# 核心分流与 DNS 策略
disable_preset_config = false
skip_domain_resource = false
disable_remote_dns = false
remote_dns_server = "auto"
secondary_dns_server = "114.114.114.114"
disable_keep_alive = false
keep_alive_url = ""

# 本地代理监听设置
socks_bind = "127.0.0.1:1080"        # 仅监听本机回环地址，避免暴露给局域网
http_bind = "127.0.0.1:1081"
socks_user = ""
socks_passwd = ""

# TUN 虚拟网卡全局模式设置 (需要管理员/root 权限)
tun_mode = false
add_route = false
dns_hijack = false
fake_ip = false
debug_dump = false

# 自定义分流域名列表
custom_proxy_domain = [
    # "portal.example.edu.cn",
    # "lib.example.edu.cn",
    # "cnki.net",
]

# 自定义 DNS 解析列表
custom_dns = [
    # { host_name = "portal.example.edu.cn", ip = "10.10.1.1" }
]

# 端口转发规则 (可选)
port_forwarding = [
    # { network_type = "tcp", bind_address = "127.0.0.1:8080", remote_address = "10.10.10.10:80" }
]
